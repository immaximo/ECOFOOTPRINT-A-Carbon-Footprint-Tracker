
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /monthlyUsageData/{usageId} {
      // Allow any signed-in user to read and write.
      // The activity log will be used to track changes.
      allow read, write: if isSignedIn();
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      // A user can create their own user document.
      allow create: if request.auth.uid == userId;
      // A user can only update or delete their own document.
      allow update, delete: if isOwner(userId);
    }
    
    match /activityLogs/{logId} {
      // Allow any signed-in user to read logs.
      allow read: if isSignedIn();
      // Client can write to its own activity log
      allow write: if isSignedIn() && request.auth.uid == request.resource.data.userId;
    }
  }
}
